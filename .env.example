# Copy to .env and adjust as needed. Every variable here is read by
# PipelineConfig.load_from_env() in src/config.py — that file is the source
# of truth if this ever drifts; see docs/FULL_PRODUCTION_RUN.md for the
# fully-verified end-to-end production walkthrough.

# Backend mode: demo | production | auto
ONTO_BACKEND_MODE=auto
ONTO_USE_PRODUCTION_BACKENDS=false
ONTO_REQUIRE_PRODUCTION_BACKENDS=false

# Storage
ONTO_SQLITE_PATH=svo_data.db
ONTO_SQLITE_BUSY_TIMEOUT_S=30

# Elasticsearch (lexical retrieval backend)
ONTO_ES_ENABLED=false
ONTO_ES_HOST=localhost
ONTO_ES_PORT=9200
ONTO_ES_INDEX=svo_chunks

# Milvus (semantic retrieval backend)
ONTO_MILVUS_ENABLED=false
ONTO_MILVUS_HOST=localhost
ONTO_MILVUS_PORT=19530
ONTO_MILVUS_COLLECTION=svo_embeddings
ONTO_MILVUS_DIM=384

# Neo4j (graph retrieval backend)
ONTO_NEO4J_ENABLED=false
ONTO_NEO4J_URI=bolt://localhost:7687
ONTO_NEO4J_USER=neo4j
ONTO_NEO4J_PASSWORD=password

# Model selection
# ONTO_EMBEDDING_MODEL: simple (5-dim hash, no deps) | transformer (DistilBERT)
# ONTO_SVO_EXTRACTOR: mock (verb-phrase heuristic, no deps) | transformer (flan-t5, few-shot with heuristic fallback)
# ONTO_CONCEPT_EXTRACTOR: mock | transformer (flan-t5-large, few-shot)
ONTO_EMBEDDING_MODEL=simple
ONTO_SVO_EXTRACTOR=mock
ONTO_CONCEPT_EXTRACTOR=mock
ONTO_VALIDATOR=minimal

# Query routing: gates which of the 3 retrievers run per query type.
# Set false to always query all three (pre-routing behavior).
ONTO_ENABLE_QUERY_ROUTING=true

# LM judge (adjudicates uncertain/conflicting evidence)
ONTO_ENABLE_LM_JUDGE=false
ONTO_JUDGE_MODEL=
ONTO_JUDGE_TIMEOUT_S=20

# Caching
ONTO_ENABLE_CACHE=true
ONTO_CACHE_DB_PATH=cache.db
ONTO_EMBEDDING_CACHE_TTL_DAYS=30
ONTO_RETRIEVAL_CACHE_TTL_DAYS=7
ONTO_VERDICT_CACHE_TTL_DAYS=14

# Feedback loop
ONTO_ENABLE_FEEDBACK=true
ONTO_FEEDBACK_DB_PATH=feedback.db

# Conflict registry: meta-model-vs-ontology disagreements awaiting human
# adjudication (decision D1, docs/ONTOLOGY_COMPLIANCE_PLAN.md §6). Resolves
# alongside feedback.db.
ONTO_ENABLE_CONFLICT_REGISTRY=true
ONTO_CONFLICT_DB_PATH=conflicts.db

# Logging
ONTO_VERBOSE=false
ONTO_LOG_BACKEND_USAGE=false

# ---------------------------------------------------------------------------
# Ontology compliance validation — PLANNED, NOT YET READ BY load_from_env().
# Listed here because the input paths are gitignored (see .gitignore) and this
# is where someone will look for them. Design: docs/ONTOLOGY_COMPLIANCE_PLAN.md
# Remove this banner as each variable lands in src/config.py.
# ---------------------------------------------------------------------------

# Inputs. Not versioned — supply per deployment.
ONTO_ONTOLOGY_PATH=Ontology n metamodel/Ontology_V4_description.json
ONTO_METAMODEL_PATH=Ontology n metamodel/Final_Ontology_meta_model.json
ONTO_DOCUMENT_CORPUS_PATH=Documents/

# Plane A (structural conformance) and Plane B (evidential grounding)
ONTO_ENABLE_METAMODEL_CONFORMANCE=true
ONTO_ENABLE_ONTOLOGY_GROUNDING=true
# error | warning | info — findings below this severity are omitted from the report
ONTO_CONFORMANCE_SEVERITY_THRESHOLD=warning
# Comma-separated subset of: edge,sipoc,decision,description
ONTO_ONTOLOGY_CLAIM_KINDS=edge,sipoc,decision,description

# Grounding corpus. IT4IT is 294 pages vs 24 for the wb_* process manuals, so
# it stays opt-in (decision D4).
ONTO_INCLUDE_IT4IT_CORPUS=false
